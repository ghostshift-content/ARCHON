{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "archon://schemas/agent-team-plan",
  "title": "ARCHON canonical agent team plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["taskId", "runtime_mode", "mode", "roles", "assignments", "verifier"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "runtime_mode": { "enum": ["shadow", "canary", "active"] },
    "drives_execution": { "type": "boolean" },
    "mode": { "enum": ["blackbox", "static", "whitebox"] },
    "roles": {
      "type": "object",
      "required": ["LEAD", "INVENTORY", "RESEARCHER", "EXPLORE", "VERIFIER"]
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "workstream_id", "skill_families", "max_explore_children"]
      }
    },
    "verifier": {
      "type": "object",
      "required": ["lenses", "batches", "assignments", "admission_rule"]
    }
  }
}
